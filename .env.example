# Copy to `.env` and adjust. Real environment variables take precedence over this file.

# Interface to bind to.
GAME_SERVER_HOST=0.0.0.0
# HTTP port (1-65535).
GAME_SERVER_PORT=8000
# One of: critical, error, warning, info, debug, trace.
GAME_SERVER_LOG_LEVEL=info

# Directory challenge images are stored in (created if missing). Relative paths are
# resolved against the working directory.
GAME_SERVER_IMAGE_BASE_PATH=data/images
# Largest accepted challenge image, in bytes (default 10 MiB).
GAME_SERVER_MAX_IMAGE_BYTES=10485760

# Oldest accepted photo: max seconds from capture-time to server receive time (> 0).
GAME_SERVER_MAX_CAPTURE_AGE_SECONDS=300
# How many seconds capture-time may be ahead of server receive time, for phone clock drift (> 0).
GAME_SERVER_MAX_CLOCK_SKEW_SECONDS=30

# A photo within this many bits (0-32, of a 64-bit perceptual hash) of a photo already
# accepted in the same session is rejected as duplicate_photo.
GAME_SERVER_PHASH_MAX_DISTANCE=6

# Minimum seconds between advisory proximity hints per (session, participant) (> 0).
GAME_SERVER_PROXIMITY_HINT_INTERVAL_SECONDS=10

# How long an arrival's one-time code stays valid, in seconds (> 0).
GAME_SERVER_ARRIVAL_CODE_TTL_SECONDS=600

# --- PostgreSQL (submissions, participants, arrivals) ---
# Create the tables with `make db-migrate` (Flyway migrations, see the README's Database migrations).
# A URL (on Railway: ${{Postgres.DATABASE_URL}}), the separate fields below, or both: a field
# that is set overrides the same part of the URL. This matches `make db-up`.
GAME_SERVER_DB_URL=postgresql://postgres:postgres@localhost:5432/game_server
# GAME_SERVER_DB_HOST=db.example.com
# GAME_SERVER_DB_PORT=5432
# GAME_SERVER_DB_NAME=game_server
# GAME_SERVER_DB_USER=game_server
# GAME_SERVER_DB_PASSWORD=...
# TLS: disable, allow, prefer, require (default), verify-ca or verify-full. The local Docker
# database has no TLS. Never turn it off for a database reached over a network you don't control.
GAME_SERVER_DB_SSLMODE=disable
# For verify-ca/verify-full: the CA that signed the server's certificate (a file, or "system").
# GAME_SERVER_DB_SSLROOTCERT=/path/to/ca.pem
# A client certificate and key, if the server authenticates clients by certificate.
# GAME_SERVER_DB_SSLCERT=/path/to/client.crt
# GAME_SERVER_DB_SSLKEY=/path/to/client.key
# Seconds to wait for a connection to be established (> 0).
GAME_SERVER_DB_CONNECT_TIMEOUT_SECONDS=10
# Connections kept open (>= 0) and the most open at once (>= min).
GAME_SERVER_DB_POOL_MIN_SIZE=1
GAME_SERVER_DB_POOL_MAX_SIZE=10
# Seconds a request waits for a free connection before failing (> 0).
GAME_SERVER_DB_POOL_TIMEOUT_SECONDS=10

# The users directory's own login (directory_app), a URL: it takes the TLS, timeout and pool
# settings above, never the separate GAME_SERVER_DB_* fields. Unset: no directory. The roles'
# passwords are set once per environment (README, Deploying on Railway), never in a migration.
# GAME_SERVER_DIRECTORY_DB_URL=postgresql://directory_app:...@localhost:5432/game_server

# JSON file of game sessions to load at startup (see sessions.example.json and docs/sessions-file.md).
# Leave unset to start with no sessions.
# GAME_SERVER_SESSIONS_FILE=sessions.json

# --- Referee (visual challenge on the Claude API) ---
# Leave the key unset to disable the referee: it then makes no network calls.
# GAME_SERVER_ANTHROPIC_API_KEY=sk-ant-...
GAME_SERVER_REFEREE_MODEL=claude-haiku-4-5
# The whole referee step, retries included, ends by the deadline, in seconds (> 0): past it the
# verdict is pending, for a moderator. Each attempt waits at most the timeout (> 0), or the time
# left if that's less. Retries on connection errors, 429 and 5xx, within the deadline (>= 0).
GAME_SERVER_REFEREE_DEADLINE_SECONDS=8
GAME_SERVER_REFEREE_TIMEOUT_SECONDS=8
GAME_SERVER_REFEREE_MAX_RETRIES=2
# Long edge, in px, of the image sent to the model (> 0).
GAME_SERVER_REFEREE_MAX_IMAGE_EDGE=1568
# How many of a checkpoint's reference photos are sent with each photo, in the sessions file's
# order (0-5; 0 turns them off), and their long edge in px (> 0). They're sent to the model
# provider.
GAME_SERVER_REFEREE_MAX_REFERENCES=2
GAME_SERVER_REFEREE_REFERENCE_MAX_EDGE=768
# Model confidence (0-1) at or above which a visual check's pass/fail counts; below it the
# check is uncertain and the submission goes to a moderator.
GAME_SERVER_REFEREE_MIN_CONFIDENCE=0.8

# --- Hunt designer (organiser or admin token) ---
# What fills a draft: agent (not available yet) or stub (a fixed hunt, after the delay in seconds).
GAME_SERVER_DESIGNER_RUNNER=agent
GAME_SERVER_DESIGNER_STUB_DELAY_SECONDS=1
# The largest area a hunt covers, in km either way (> 0): bigger areas are clipped.
GAME_SERVER_DESIGNER_MAX_AREA_KM=3
# The least distance between two of a draft's checkpoints, in metres (> 0).
GAME_SERVER_DESIGNER_MIN_SPACING_M=150
# The hunt-designer agent (it uses GAME_SERVER_ANTHROPIC_API_KEY): its model, and the most turns
# (> 0) and US dollars (> 0) one run may take.
GAME_SERVER_DESIGNER_MODEL=claude-sonnet-5-5
GAME_SERVER_DESIGNER_MAX_TURNS=30
GAME_SERVER_DESIGNER_MAX_BUDGET_USD=1.00
# OpenStreetMap, for the designer's map data: the services' URLs (the public instances by
# default; their usage policies apply) and each request's timeout in seconds (> 0).
GAME_SERVER_OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
GAME_SERVER_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
GAME_SERVER_OSM_TIMEOUT_SECONDS=30

# --- Organiser MCP server (no sign-in of its own yet: enable only behind the web app's relay) ---
# Mount /mcp (true or false).
GAME_SERVER_MCP_ENABLED=false
# Host values /mcp accepts, comma-separated; name:* accepts any port. Empty: /mcp refuses all.
GAME_SERVER_MCP_ALLOWED_HOSTS=
# The web app's base URL, for links to its /moderator and /designer screens. Unset: no links.
# GAME_SERVER_WEB_APP_URL=https://play.example.com

# --- Signing in (Clerk session tokens, see src/game_server/auth.py) ---
# off (default: tokens aren't checked), optional (checked when sent) or required. Anything but
# off needs the three settings below, or the server won't start.
GAME_SERVER_AUTH_MODE=off
# Clerk's PEM public key (Dashboard > API keys), so a check makes no network call. In a one-line
# variable, write the line breaks as \n.
# GAME_SERVER_CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Clerk's Frontend API URL, which every token's iss must equal.
# GAME_SERVER_CLERK_ISSUER=https://your-slug.clerk.accounts.dev
# The web app's origin(s), comma-separated: a token's azp must be one of them.
# GAME_SERVER_CLERK_AUTHORIZED_PARTIES=https://play.example.com

# --- Provisioning people (the users directory and Clerk) ---
# Clerk's Backend API key, for writing each person's pid and role into Clerk. Unset: nothing is
# written to Clerk, and /me/provision answers 503.
# GAME_SERVER_CLERK_SECRET_KEY=sk_test_...
# The Svix signing secret of Clerk's webhook. Unset: /internal/clerk-events answers 503.
# GAME_SERVER_CLERK_WEBHOOK_SECRET=whsec_...
# One /me/provision per Clerk user per this many seconds (> 0).
GAME_SERVER_PROVISION_INTERVAL_SECONDS=5
# How often queued writes to Clerk are sent, in seconds (> 0), and the UTC hour (0-23) of the
# nightly reconcile with Clerk.
GAME_SERVER_CLERK_SYNC_INTERVAL_SECONDS=10
GAME_SERVER_CLERK_RECONCILE_HOUR_UTC=3
