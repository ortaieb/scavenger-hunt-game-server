  {
    "name": "publish_hunt",
    "description": "Publish the draft's accepted checkpoints as a session, playable at once. Final.\n\nThe result holds the session's join codes and its moderator code. They are credentials:\ngive each to its holders only (a team's join code to that team, the moderator code to\nthe moderator) and never repeat them elsewhere. No other tool returns them.\n",
    "inputSchema": {
      "type": "object",
      "$defs": {
        "PublishRequest": {
          "additionalProperties": false,
          "description": "The session to make of the draft: its name, planned window and teams.",
          "properties": {
            "name": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "start-time": {
              "format": "date-time",
              "title": "Start-Time",
              "type": "string"
            },
            "end-time": {
              "format": "date-time",
              "title": "End-Time",
              "type": "string"
            },
            "teams": {
              "items": {
                "maxLength": 40,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 10,
              "minItems": 1,
              "title": "Teams",
              "type": "array"
            }
          },
          "required": [
            "name",
            "start-time",
            "end-time",
            "teams"
          ],
          "title": "PublishRequest",
          "type": "object"
        }
      },
      "properties": {
        "draft_id": {
          "format": "uuid",
          "title": "Draft Id",
          "type": "string"
        },
        "request": {
