            "status": {
              "enum": [
                "ok",
                "error"
              ],
              "title": "Status",
              "type": "string"
            },
            "error-code": {
              "anyOf": [
                {
                  "enum": [
                    "deadline",
                    "timeout",
                    "api_error",
                    "refusal",
                    "max_tokens",
                    "invalid_output",
                    "invalid_image"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error-Code"
            }
          },
          "required": [
            "status",
            "error-code"
          ],
          "title": "RefereeOut",
          "type": "object"
        },
        "RulingOut": {
          "description": "A ruling as recorded.",
          "properties": {
            "ruling": {
              "enum": [
                "approve",
                "reject"
              ],
              "title": "Ruling",
              "type": "string"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Note"
            },
            "ruled-at": {
              "title": "Ruled-At",
              "type": "string"
            }
          },
          "required": [
            "ruling",
            "note",
            "ruled-at"
          ],
          "title": "RulingOut",
          "type": "object"
        },
        "StoredCheckOut": {
          "description": "A check that ran: what the player was told (`reason`), and why (`detail`).",
          "properties": {
            "check": {
              "title": "Check",
              "type": "string"
            },
            "outcome": {
              "enum": [
                "passed",
                "failed",
                "uncertain",
                "skipped"
              ],
              "title": "Outcome",
              "type": "string"
            },
            "confidence": {
              "title": "Confidence",
              "type": "number"
            },
            "reason": {
              "title": "Reason",
              "type": "string"
            },
            "detail": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Detail"
            }
          },
          "required": [
            "check",
            "outcome",
            "confidence",
            "reason",
            "detail"
          ],
          "title": "StoredCheckOut",
          "type": "object"
        }
      },
      "description": "A submission in full, but for the photo.",
      "properties": {
        "submission": {
          "title": "Submission",
          "type": "integer"
        },
        "team": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Team"
        },
        "checkpoint": {
          "$ref": "#/$defs/CheckpointOut"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "received-at": {
          "title": "Received-At",
          "type": "string"
        },
        "pose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pose"
        },
        "scene": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scene"
        },
        "verdict": {
          "enum": [
            "failed",
            "pending",
            "pass"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "effective-verdict": {
          "enum": [
            "failed",
            "pending",
            "pass"
          ],
          "title": "Effective-Verdict",
          "type": "string"
        },
        "checks": {
