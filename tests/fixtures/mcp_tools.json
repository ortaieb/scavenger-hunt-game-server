          },
          "title": "Rulings",
          "type": "array"
        },
        "moderator-link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Moderator-Link"
        }
      },
      "required": [
        "submission",
        "team",
        "checkpoint",
        "attempt",
        "received-at",
        "pose",
        "scene",
        "verdict",
        "effective-verdict",
        "checks",
        "referee",
        "rulings",
        "moderator-link"
      ],
      "title": "SubmissionRead",
      "type": "object"
    },
    "annotations": {
